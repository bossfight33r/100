  "components": {
    "schemas": {
      "CropRequest": {
        "properties": {
          "center_x": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Center X",
            "description": "Центр кропа 0..1; null — вернуть авто"
          }
        },
        "type": "object",
        "title": "CropRequest"
      },
      "EditMetadata": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "hashtags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hashtags"
          },
          "platform": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Platform"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "EditMetadata"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "ingesting",
          "transcribing",
          "selecting",
          "reframing",
          "captioning",
          "rendering",
          "awaiting_review",
          "scheduled",
          "publishing",
          "published",
          "failed"
        ],
        "title": "JobStatus"
      },
      "ManualStats": {
        "properties": {
          "views": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Views"
          },
          "likes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Likes",
            "default": 0
          },
          "comments": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Comments",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "views"
        ],
        "title": "ManualStats"
      },
      "NewJob": {
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "title": "Source",
            "description": "Абсолютный путь к файлу или http(s) URL"
          },
          "campaign_id": {
            "type": "string",
            "title": "Campaign Id"
          }
        },
        "type": "object",
        "required": [
          "source",
          "campaign_id"
        ],
        "title": "NewJob"
      },
      "Platform": {
        "type": "string",
        "enum": [
          "youtube",
          "tiktok",
          "instagram"
        ],
        "title": "Platform"
      },
      "Reject": {
        "properties": {
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          }
        },
        "type": "object",
        "title": "Reject"
      },
      "RetryRequest": {
        "properties": {
          "force_stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StageName"
              },
