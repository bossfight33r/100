# Скопируй в .env и заполни. .env в .gitignore — не коммитить.
CF_DATA_DIR=data
# PostgreSQL для нескольких машин (пусто — SQLite в data/db/)
CF_DB_URL=
CF_CAMPAIGNS_DIR=config/campaigns
CF_ACCOUNTS_FILE=config/accounts.yaml

# Бэкенды: auto | mlx | faster_whisper | fake
CF_TRANSCRIBER=auto
CF_WHISPER_MODEL=large-v3-turbo
# anthropic | ollama | fake
CF_LLM_PROVIDER=anthropic
CF_LLM_MODEL=claude-opus-5-5
CF_LLM_EFFORT=medium
CF_OLLAMA_URL=http://localhost:11434
CF_OLLAMA_MODEL=qwen2.5:7b-instruct
CF_OLLAMA_NUM_CTX=16384
# mediapipe | fake
CF_FACE_DETECTOR=mediapipe
CF_FACE_MODEL_PATH=data/models/blaze_face_short_range.tflite
# auto | videotoolbox | nvenc | x264
CF_ENCODER=auto
CF_CAPTION_FONT=Arial

# inline | rq
CF_QUEUE=inline
CF_REDIS_URL=redis://localhost:6379/0
# Маршрутизация: доп. теги этого воркера / требования job к воркеру (через запятую)
CF_WORKER_TAGS=
CF_JOB_REQUIRE_TAGS=

# Хранилище: local | s3 (S3/MinIO; ключи — стандартные AWS_*)
CF_STORAGE=local
CF_S3_BUCKET=
CF_S3_PREFIX=
CF_S3_ENDPOINT_URL=

# Секреты (только env)
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Локальный Bot API server для файлов до 2 ГБ (опционально)
CF_TELEGRAM_API_URL=
# Telegram user id через запятую
CF_ADMIN_IDS=
# Путь к OAuth client secrets из Google Cloud Console
CF_YOUTUBE_CLIENT_SECRETS=data/secrets/youtube_client_secret.json
